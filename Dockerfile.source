# syntax=docker/dockerfile:1
# Builds the agent from source for the build machine's architecture, for trying it out.
# Releases use Dockerfile with binaries built per architecture.
FROM docker.io/library/rust:1.99.0-alpine@sha256:0cce0a5e0e8ba67b455257a3a02a1d99005f382748789d6464460028810f1627 AS build
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY . .
RUN cargo build --release --locked -p iohr-agent && cp target/release/iohr-agent /iohr-agent

FROM gcr.io/distroless/static-debian13:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
COPY --from=build --chmod=0555 /iohr-agent /usr/bin/iohr-agent
USER 65532:65532
ENV IOHR_AGENT_CONFIG=/etc/iohr-agent/agent.toml
ENTRYPOINT ["/usr/bin/iohr-agent"]
CMD ["run", "--json-logs"]
