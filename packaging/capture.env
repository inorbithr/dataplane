# iohr-capture settings (read by /usr/lib/systemd/system/iohr-capture.service).
# The interfaces to count on, ingress and egress: one or more names, separated by commas
# or spaces (at most 16). Required, unless IOHR_CAPTURE_ALL_INTERFACES=true.
# `iohr-capture interfaces` lists this host's interfaces and what --all would pick.
IOHR_CAPTURE_INTERFACES=
# Instead of a list: every interface that is up and physical, a bond or a VLAN. Loopback,
# bond members, and container, Kubernetes and VPN devices (docker*, veth*, br-*, cni*,
# flannel*, cali*, ...) are skipped; name them in the list above to include them. The
# selection is made at each start: an interface added later is counted after a restart.
#IOHR_CAPTURE_ALL_INTERFACES=true
# The older single-name setting, still read when IOHR_CAPTURE_INTERFACES is empty.
#IOHR_CAPTURE_INTERFACE=
# Log level: error, warn, info, debug.
IOHR_CAPTURE_LOG=info
# Layers: headers (1), protocols (2), owners (4), tcp (5), timing (7, request timing per
# route template; needs protocols). The default is all of them.
#IOHR_CAPTURE_LAYERS=headers,protocols,owners,tcp,timing
# Packet copies to user space per second per CPU (token bucket; 0 = no limit), and burst.
#IOHR_CAPTURE_SAMPLES_PER_SEC=2000
#IOHR_CAPTURE_BURST=500
# Ring buffer (KiB, a power of two, 4 to 32768), flows tracked at once (at most 65536),
# poll interval (ms). The unit caps the memory of both processes at 256 MiB (MemoryMax=):
# the ring buffer plus about 2 KiB per undecided flow must fit, which the limits ensure.
#IOHR_CAPTURE_RING_BUFFER_KIB=4096
#IOHR_CAPTURE_MAX_FLOWS=16384
#IOHR_CAPTURE_POLL_MS=2000
# Who may read the aggregates socket: this group's members and the agent's user (which
# only ever gets counts). Under the unit the group comes from Group= in the unit.
#IOHR_CAPTURE_SOCKET_GROUP=iohr-capture-read
#IOHR_CAPTURE_AGENT_USER=iohr-agent
# Layer 3, whole packets: off unless set. When on, the companion keeps the latest packets
# in memory, and root can ask for a pcap file (`sudo iohr-capture pcap --seconds 30`).
# Files are 0600 in IOHR_CAPTURE_PCAP_DIR and deleted after the retention; nothing is
# ever sent anywhere. Packets carry payloads: turn this on only where you may hold them.
#IOHR_CAPTURE_PACKETS=false
# Bytes per packet (64-65535), packet copies per second per CPU (0 = no limit) and burst,
# the packets ring buffer (KiB, 256-32768) and the packets kept in memory (MiB, 1-128,
# never older than 300 s).
#IOHR_CAPTURE_SNAPLEN=65535
#IOHR_CAPTURE_PACKETS_PER_SEC=1000
#IOHR_CAPTURE_PACKETS_BURST=200
#IOHR_CAPTURE_PACKETS_RING_KIB=8192
#IOHR_CAPTURE_PACKETS_BUFFER_MIB=32
# pcap files: directory (the unit makes it), largest file a request may ask for, total
# cap, and how long a file is kept (seconds, 1-86400).
#IOHR_CAPTURE_PCAP_DIR=/var/lib/iohr-capture/pcap
#IOHR_CAPTURE_PCAP_MAX_BYTES=67108864
#IOHR_CAPTURE_PCAP_DIR_MAX_BYTES=536870912
#IOHR_CAPTURE_PCAP_RETENTION_SECS=3600
