#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
  # Who may read the aggregates socket: the agent's user, and people added on purpose.
  if ! getent group iohr-capture-read >/dev/null; then
    addgroup --system iohr-capture-read >/dev/null
  fi
  if getent passwd iohr-agent >/dev/null; then
    adduser iohr-agent iohr-capture-read >/dev/null
  fi
  if ! getent passwd iohr-capture >/dev/null; then
    adduser --system --group --no-create-home --home /nonexistent iohr-capture >/dev/null
  fi
  chown root:iohr-capture /etc/iohr-capture /etc/iohr-capture/capture.env
  chmod 0750 /etc/iohr-capture
  chmod 0640 /etc/iohr-capture/capture.env
fi
