#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
  # The agent's group owns the aggregates socket; iohr-agent's package uses it if present.
  if ! getent group iohr-agent >/dev/null; then
    addgroup --system iohr-agent >/dev/null
  fi
  if ! getent passwd iohr-capture >/dev/null; then
    adduser --system --group --no-create-home --home /nonexistent iohr-capture >/dev/null
  fi
  chown root:iohr-capture /etc/iohr-capture /etc/iohr-capture/capture.env
  chmod 0750 /etc/iohr-capture
  chmod 0640 /etc/iohr-capture/capture.env
fi
